# Development values for the Compose stack. Never use these outside a laptop.
# The full list of variables, with types and defaults, is schemas/process-config.yaml.

# Admin
APG_DATABASE_URL=postgres://apg:apg-dev-only@postgres:5432/apg
APG_ADMIN_LISTEN=0.0.0.0:9000
APG_LOG_LEVEL=info

# Node (database mode; joins the stack in build phase 2b)
APG_CONFIG_SOURCE=api_poll
APG_NODE_ID=node-1
APG_CONFIG_URL=http://admin:9000/dp
APG_NODE_TOKEN=change-me

# Secrets: in production these come from a secret store (a mounted file or the
# orchestrator's secret mechanism), never from a committed file. See
# APG_SECRET_KEY_FILE in schemas/process-config.yaml.
