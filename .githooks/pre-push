#!/bin/sh
# Runs what CI runs on a pull request before anything leaves this machine, so
# a push that would fail there fails here first. Takes about 20 minutes and
# needs Docker. It uses its own containers and leaves a running development
# stack alone.
#
# Turn it on once per clone:   make hooks
# Skip it for one push:        APG_SKIP_PREPUSH=1 git push     (or git push --no-verify)

if [ "${APG_SKIP_PREPUSH:-}" = "1" ]; then
  echo "pre-push: skipped (APG_SKIP_PREPUSH=1)"
  exit 0
fi

# Deleting a branch or a tag sends no code, so there is nothing to test.
sends_code=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
    0000000000000000000000000000000000000000) ;;
    *) sends_code=1 ;;
  esac
done
[ "$sends_code" = 1 ] || exit 0

if ! docker info >/dev/null 2>&1; then
  echo "pre-push: Docker is not running, so the tests cannot run. Start it, or push with APG_SKIP_PREPUSH=1."
  exit 1
fi

cd "$(git rev-parse --show-toplevel)" || exit 1
# Git Bash on Windows rewrites container paths unless told not to.
export MSYS_NO_PATHCONV=1
echo "pre-push: running the checks CI runs (make prepush). Skip with APG_SKIP_PREPUSH=1."
if ! make prepush; then
  echo
  echo "pre-push: a check failed, nothing was pushed. The log of the failing step is above."
  exit 1
fi
