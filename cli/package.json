{
  "name": "apgctl",
  "version": "0.1.0",
  "description": "Command-line client for valkv-apg: declarative configuration, revisions, and the Admin API.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "apgctl": "dist/apgctl.js" },
  "files": ["dist", "schemas", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:integ": "vitest run --config vitest.integ.config.ts",
    "prepack": "node -e \"require('fs').cpSync('../schemas','schemas',{recursive:true})\" && npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "@vitest/coverage-v8": "^2.1.8",
    "vitest": "^2.1.8"
  }
}
