{
  "name": "valkv-apg-admin",
  "version": "0.1.0",
  "description": "Control plane for valkv-apg: Admin API, data-plane API, jobs, and the UI host.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integ": "vitest run --config vitest.integ.config.ts",
    "openapi": "tsx src/index.ts openapi > openapi.json"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.2.0",
    "jose": "^5.9.6",
    "js-yaml": "^4.1.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.3.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
