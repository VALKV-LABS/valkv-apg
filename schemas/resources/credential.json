{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valkv-apg.dev/schemas/resources/credential.json",
  "title": "Credential",
  "description": "A credential held by a consumer (spec §10). Secrets are write-only.",
  "type": "object",
  "required": ["type"],
  "properties": {
    "id": { "$ref": "../common.json#/$defs/id" },
    "consumer_id": { "$ref": "../common.json#/$defs/id" },
    "name": { "$ref": "../common.json#/$defs/name" },
    "type": { "enum": ["key", "basic", "mtls"] },
    "enabled": { "type": "boolean", "default": true },
    "expires_at": { "$ref": "../common.json#/$defs/timestamp" },
    "labels": { "$ref": "../common.json#/$defs/labels" },
    "revision": { "$ref": "../common.json#/$defs/revision" },
    "created_at": { "$ref": "../common.json#/$defs/timestamp" },
    "updated_at": { "$ref": "../common.json#/$defs/timestamp" }
  },
  "oneOf": [
    {
      "properties": {
        "type": { "const": "key" },
        "key": { "description": "Write-only. Generated when omitted (Admin API only).", "writeOnly": true,
                 "oneOf": [{ "type": "string", "minLength": 16, "maxLength": 256 }, { "$ref": "../common.json#/$defs/secretValue" }] },
        "key_prefix": { "type": "string", "readOnly": true }
      }
    },
    {
      "properties": {
        "type": { "const": "basic" },
        "username": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^:]+$" },
        "password": { "writeOnly": true,
                      "oneOf": [{ "type": "string", "minLength": 8, "maxLength": 256 }, { "$ref": "../common.json#/$defs/secretValue" }] }
      },
      "required": ["username"]
    },
    {
      "properties": {
        "type": { "const": "mtls" },
        "identity": { "description": "The value matched per mtls_auth.consumer_by.", "type": "string", "minLength": 1, "maxLength": 512 }
      },
      "required": ["identity"]
    }
  ],
  "unevaluatedProperties": false
}
