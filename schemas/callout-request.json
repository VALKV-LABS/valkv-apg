{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valkv-apg.dev/schemas/callout-request.json",
  "title": "CalloutRequest",
  "description": "What a node POSTs to the service of an http_callout plugin (spec §9.4).",
  "type": "object",
  "required": ["phase", "request", "workspace_id", "route"],
  "properties": {
    "phase": { "enum": ["request", "response"] },
    "request": {
      "type": "object",
      "required": ["id", "method", "scheme", "host", "path", "query", "client_ip", "headers"],
      "properties": {
        "id": { "type": "string" },
        "method": { "type": "string" },
        "scheme": { "enum": ["http", "https"] },
        "host": { "type": "string" },
        "path": { "description": "The normalised request path.", "type": "string" },
        "query": { "description": "The raw query string, without the question mark.", "type": "string" },
        "client_ip": { "type": "string" },
        "headers": { "description": "Lower-cased names. Authorization and Cookie are left out unless include_headers lists them.", "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "response": {
      "description": "Present in the response phase.",
      "type": "object",
      "required": ["status", "headers"],
      "properties": {
        "status": { "type": "integer" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "workspace_id": { "type": "string" },
    "route": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "string" }, "name": { "type": "string" } } },
    "consumer": { "description": "Null when no consumer was authenticated.", "type": ["object", "null"], "properties": { "id": { "type": "string" }, "name": { "type": "string" } } }
  }
}
