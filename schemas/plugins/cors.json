{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valkv-apg.dev/schemas/plugins/cors.json",
  "title": "cors",
  "description": "Cross-origin resource sharing. Preflight requests are answered by the gateway (spec §9.4).",
  "type": "object",
  "required": ["origins"],
  "additionalProperties": false,
  "properties": {
    "origins": { "description": "Exact origins, * for any, or one wildcard label such as https://*.example.com.", "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
                 "items": { "type": "string", "pattern": "^(\\*|https?://(\\*\\.)?[A-Za-z0-9.-]+(:[0-9]{1,5})?)$" } },
    "methods": { "type": "array", "uniqueItems": true, "default": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"], "items": { "$ref": "../common.json#/$defs/httpMethod" } },
    "headers": { "description": "Request headers allowed. Empty means: whatever the preflight asks for.", "type": "array", "uniqueItems": true, "maxItems": 64, "default": [],
                 "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" } },
    "expose_headers": { "type": "array", "uniqueItems": true, "maxItems": 64, "default": [], "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" } },
    "max_age": { "description": "Seconds a browser may cache the preflight answer.", "type": "integer", "minimum": 0, "maximum": 86400, "default": 86400 },
    "credentials": { "type": "boolean", "default": false }
  },
  "if": { "properties": { "credentials": { "const": true } }, "required": ["credentials"] },
  "then": { "properties": { "origins": { "not": { "contains": { "const": "*" } } } } }
}
