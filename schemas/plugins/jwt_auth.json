{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valkv-apg.dev/schemas/plugins/jwt_auth.json",
  "title": "jwt_auth",
  "description": "Verifies a JSON Web Token and optionally maps it to a consumer (spec §9.4).",
  "type": "object",
  "required": ["issuer"],
  "additionalProperties": false,
  "properties": {
    "issuer": { "description": "The iss claim must equal this.", "type": "string", "minLength": 1, "maxLength": 512 },
    "audiences": { "description": "When not empty, the aud claim must contain one of these.", "type": "array", "uniqueItems": true, "maxItems": 32, "default": [], "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
    "jwks_url": { "description": "Where the signing keys are published.", "type": "string", "pattern": "^https?://", "maxLength": 2048 },
    "jwks": { "description": "Signing keys inline, as a JSON Web Key Set.", "type": "object", "required": ["keys"], "properties": { "keys": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "object" } } } },
    "secret": { "description": "Shared secret for HS256.", "x-apg-secret": true, "$ref": "../common.json#/$defs/secretValue" },
    "algorithms": { "type": "array", "minItems": 1, "uniqueItems": true, "default": ["RS256", "ES256"], "items": { "enum": ["RS256", "RS384", "RS512", "ES256", "ES384", "EdDSA", "HS256"] } },
    "leeway_secs": { "description": "Clock difference tolerated for exp and nbf.", "type": "integer", "minimum": 0, "maximum": 600, "default": 60 },
    "token_sources": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "default": ["header:Authorization"],
                       "items": { "type": "string", "pattern": "^(header|query|cookie):[A-Za-z0-9_-]{1,64}$" } },
    "required": { "description": "When false, a request with no token passes unauthenticated.", "type": "boolean", "default": true },
    "consumer_claim": { "description": "A claim whose value must equal a consumer custom_id.", "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
    "claims_to_headers": { "description": "Claim name to the request header that carries it upstream.", "type": "object", "maxProperties": 32, "default": {},
                           "propertyNames": { "pattern": "^[A-Za-z0-9_.-]{1,64}$" }, "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" } },
    "jwks_cache_secs": { "type": "integer", "minimum": 10, "maximum": 86400, "default": 300 },
    "anonymous": { "description": "A consumer name to run as when no token is presented.", "$ref": "../common.json#/$defs/name" }
  },
  "oneOf": [{ "required": ["jwks_url"] }, { "required": ["jwks"] }, { "required": ["secret"] }]
}
