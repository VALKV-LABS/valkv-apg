# systemd unit for a valkv-apg node installed from the release tarball.
#
#   install -m 0755 valkv-apg /usr/local/bin/valkv-apg
#   install -m 0644 valkv-apg.service /etc/systemd/system/
#   install -m 0640 -g valkv-apg valkv-apg.env /etc/valkv-apg/env      # then edit it
#   useradd --system --no-create-home --shell /usr/sbin/nologin valkv-apg
#   systemctl daemon-reload && systemctl enable --now valkv-apg
#
# Upgrading without dropping connections (the new binary takes over the
# listening sockets from the old one):
#
#   install -m 0755 valkv-apg /usr/local/bin/valkv-apg
#   systemctl reload valkv-apg
[Unit]
Description=valkv-apg API gateway node
Documentation=https://github.com/valkv-labs/valkv-apg
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=valkv-apg
Group=valkv-apg
EnvironmentFile=/etc/valkv-apg/env
ExecStart=/usr/local/bin/valkv-apg
# Start the new binary, which asks the running one for its listeners; then
# tell the old one to finish what it is serving and exit.
ExecReload=/bin/sh -c '/usr/local/bin/valkv-apg --upgrade & sleep 2; kill -QUIT $MAINPID'
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=on-failure
RestartSec=2

# The node's cache of its configuration, the usage queue, issued certificates.
StateDirectory=valkv-apg
RuntimeDirectory=valkv-apg
ConfigurationDirectory=valkv-apg

# Bind ports 80 and 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
