# Environment of the valkv-apg node. Every variable is described in
# docs/reference/configuration.md. Lines starting with # are ignored.

# Where the node keeps its cache, usage queue and issued certificates.
APG_DATA_DIR=/var/lib/valkv-apg
APG_LISTEN_HTTPS=0.0.0.0:443
APG_LISTEN_HTTP=0.0.0.0:80
# Health, readiness and metrics. Loopback only unless you have a reason.
APG_LISTEN_MGMT=127.0.0.1:9100

# ── One of the two blocks below ──────────────────────────────────────────────

# Standalone: the whole configuration is one file (or a directory of them).
APG_CONFIG_SOURCE=file
APG_CONFIG_FILE=/etc/valkv-apg/apg.yaml

# With a control plane: the node polls it and keeps serving if it goes away.
#APG_CONFIG_SOURCE=api_poll
#APG_CONFIG_URL=https://admin.internal.example:9000/dp
#APG_NODE_ID=edge-1
#APG_NODE_TOKEN=
#APG_SECRET_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────

# Load balancers whose X-Forwarded-For is to be believed.
#APG_TRUSTED_PROXIES=10.0.0.0/8
# Certificates from an ACME authority for domains with tls.mode: acme.
#APG_ACME_EMAIL=ops@example.com
